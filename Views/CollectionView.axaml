<UserControl x:Class="MTGcollector_app.Views.CollectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MTGcollector_app.ViewModels"
             xmlns:models="clr-namespace:MTGcollector_app.Models"
             xmlns:img="clr-namespace:MTGcollector_app.Helpers"
             x:Name="Root"
             x:DataType="vm:CollectionViewModel"
             mc:Ignorable="d"
             Background="White">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24">

    <TextBlock Grid.Row="0" Text="My Collection" FontSize="32" FontWeight="Bold" Margin="0,0,0,8" />

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="{Binding ImportMessage}" Foreground="#198754" IsVisible="{Binding ImportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding SearchError}" Foreground="#DC3545" IsVisible="{Binding SearchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <TextBox Grid.Column="0" PlaceholderText="Search for a card..." Text="{Binding SearchText, Mode=TwoWay}" />
      <Button Grid.Column="1"
              Content="Search"
              Command="{Binding SearchScryfallCommand}"
              IsEnabled="{Binding !Searching}"
              Margin="10,0,0,0"
              Padding="20,0"
              Background="#0066CC"
              Foreground="White"
              Cursor="Hand" />
    </Grid>

    <Border Grid.Row="3"
            Margin="0,0,0,16"
            Padding="12"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#FFC107"
            Background="#FFF8E1"
            IsVisible="{Binding SelectedCard, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,120,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Edit card" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" Grid.Column="0" PlaceholderText="Name" Text="{Binding EditCardName, Mode=TwoWay}" Margin="0,0,8,0" />
        <NumericUpDown Grid.Row="1"
                       Grid.Column="1"
                       Minimum="0"
                       Maximum="999"
                       Increment="1"
                       FormatString="0"
                       Value="{Binding EditNumberOfCopies, Mode=TwoWay}"
                       Margin="0,0,8,0" />
        <Button Grid.Row="1"
                Grid.Column="2"
                Content="Save"
                Command="{Binding SaveEditCommand}"
                Background="#198754"
                Foreground="White"
                Margin="0,0,8,0"
                Cursor="Hand" />
        <Button Grid.Row="1"
                Grid.Column="3"
                Content="Cancel"
                Command="{Binding CancelEditCommand}"
                Cursor="Hand" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" RowDefinitions="Auto,*,Auto,*">

      <TextBlock Grid.Row="0" Text="Search Results" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20">
        <ItemsControl ItemsSource="{Binding SearchResults}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ScryfallCard">
              <Border Width="220" Margin="8" Padding="10" CornerRadius="8" BorderThickness="1" BorderBrush="#CCCCCC">
                <StackPanel>
                  <Image Height="280" Stretch="Uniform" img:WebImage.Url="{Binding ImageUrl}" />
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Margin="0,10,0,5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SetName}" FontSize="12" />
                  <TextBlock Text="{Binding CollectorNumber}" FontSize="12" />
                  <Button Content="Add to Collection"
                          Margin="0,10,0,0"
                          Command="{Binding $parent[ItemsControl].((vm:CollectionViewModel)DataContext).AddScryfallCardCommand}"
                          CommandParameter="{Binding}"
                          Background="#28A745"
                          Foreground="White"
                          Cursor="Hand" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="2" Text="My Cards" FontSize="18" FontWeight="Bold" Margin="0,20,0,10" />
      <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="No cards in your collection yet. Search Scryfall and add one."
                     Foreground="Gray"
                     Margin="0,0,0,10"
                     IsVisible="{Binding HasNoCards}" />
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Card">
                <Border Margin="0,4" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="#CCCCCC">
                  <Grid ColumnDefinitions="80,*,100,100,100,Auto" VerticalAlignment="Center">
                    <Image Grid.Column="0" Width="60" Height="84" Stretch="Uniform" img:WebImage.Url="{Binding ImageUrl}" />

                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                      <TextBlock Text="{Binding SetName}" FontSize="12" />
                      <TextBlock Text="{Binding SetCode}" FontSize="12" />
                      <TextBlock Text="{Binding CollectorNumber}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Copies" FontSize="12" />
                      <TextBlock Text="{Binding Copies.Count}" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                      <TextBlock Text="Foil" FontSize="12" />
                      <TextBlock Text="{Binding Copies.Count}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Rarity" FontSize="12" />
                      <TextBlock Text="{Binding Rarity}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                      <Button Content="Edit"
                              Command="{Binding $parent[ItemsControl].((vm:CollectionViewModel)DataContext).StartEditCommand}"
                              CommandParameter="{Binding}"
                              Margin="0,0,4,0"
                              Background="#FFC107"
                              Foreground="White"
                              Cursor="Hand" />
                      <Button Content="Remove"
                              Command="{Binding $parent[ItemsControl].((vm:CollectionViewModel)DataContext).DeleteCardCommand}"
                              CommandParameter="{Binding}"
                              Background="#DC3545"
                              Foreground="White"
                              Cursor="Hand" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
