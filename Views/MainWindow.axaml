<Window
    x:Class="MTGcollector_app.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MTGcollector_app.ViewModels"
    xmlns:views="clr-namespace:MTGcollector_app.Views"
    x:DataType="vm:MainWindowViewModel"
    Title="MTGcollector"
    Width="1400"
    Height="900">

    <Grid ColumnDefinitions="220,*" Background="White">


        <!-- Sidebar -->
        <Border
            Grid.Column="0"
            Padding="20"
            Background="#F5F5F5">

            <StackPanel>

                <TextBlock
                    Text="MTGcollector"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,0,30" />

                <Button
                    Content="Collection"
                    Margin="0,5" />

                <Button
                    Content="Decks"
                    Margin="0,5" />

                <Button
                    Content="Import"
                    Margin="0,5" />

                <Button
                    Content="Settings"
                    Margin="0,5" />

            </StackPanel>

        </Border>

        <!-- Content -->
        <views:CollectionView
            Grid.Column="1"
            DataContext="{Binding CurrentViewModel}" />

    </Grid>

</Window>